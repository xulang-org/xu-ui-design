{
  "name": "@xulang-org/xu-ui-design",
  "version": "0.1.1-dev.2",
  "private": true,
  "description": "XU UI standards, tokens, SVG icons and interactive reference showcase",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --config=playwright.visual.config.mjs",
    "package": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  }
}
